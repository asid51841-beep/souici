<!DOCTYPE html>
<html lang="ar">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hwak Nti Dima F El Bal - Maram</title>
    <style>
        body {
            margin: 0;
            background-color: #000;
            overflow: hidden;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            cursor: pointer;
            font-family: Arial, sans-serif;
        }

        .heart {
            position: relative;
            width: 300px;
            height: 300px;
        }

        .love_word {
            position: absolute;
            color: #ea80b0;
            font-size: 1.2rem;
            white-space: nowrap;
            text-shadow: 0 0 10px #fff;
            /* السرعة رابيد (1 ثانية) */
            animation: move_rapid 1s infinite ease-in-out alternate;
            font-weight: bold;
        }

        @keyframes move_rapid {
            0% { transform: scale(1); opacity: 0.7; }
            100% { transform: scale(1.3); opacity: 1; }
        }

        .hint {
            position: fixed;
            bottom: 20px;
            color: #ea80b0;
            font-size: 0.9rem;
            text-align: center;
            width: 100%;
            text-shadow: 0 0 5px #000;
        }

        /* حاوية مخفية لليوتيوب */
        #youtube-player {
            display: none;
        }
    </style>
</head>
<body>

    <div class="heart" id="heartContainer"></div>
    <div class="hint" id="clickHint">اضغط في أي مكان لتشغيل الموسيقى 🎵</div>

    <iframe id="youtube-player" 
        src="https://www.youtube.com/embed/HdNtykq771Q?enablejsapi=1" 
        allow="autoplay">
    </iframe>

    <script>
        const container = document.getElementById('heartContainer');
        const totalWords = 85; 

        // رسم القلب بكلمة MARAM
        for (let i = 0; i < totalWords; i++) {
            const word = document.createElement('div');
            word.className = 'love_word';
            word.innerText = 'MARAM';
            
            const t = (i / totalWords) * 2 * Math.PI;
            const x = 16 * Math.pow(Math.sin(t), 3);
            const y = -(13 * Math.cos(t) - 5 * Math.cos(2 * t) - 2 * Math.cos(3 * t) - Math.cos(4 * t));
            
            word.style.left = `${x * 12 + 150}px`;
            word.style.top = `${y * 12 + 150}px`;
            word.style.animationDelay = `${i * 0.02}s`;
            
            container.appendChild(word);
        }

        // تشغيل أغنية ولاد البهجة عند الضغط
        let playing = false;
        document.body.addEventListener('click', () => {
            if (!playing) {
                const player = document.getElementById('youtube-player');
                player.src += "&autoplay=1";
                document.getElementById('clickHint').style.display = 'none';
                playing = true;
            }
        });
    </script>
</body>
</html>
